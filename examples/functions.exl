extern fun printf(format: string): i32;

fun add(a: i32, b: i32): i32 {
    return a + b;
}

fun is_same(a: i32, b: i32): bool {
    return a == b;
}

fun main() {
    add(1, 1);

    let same = is_same(1, 2);

    let unsigned: f32 = 1.0;

    let hello = "Hello";

    printf("Hello, World!\n");
}