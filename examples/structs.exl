extern fun printf(fmt: string, ...): i32;

struct Counter {
    value: i32,
}

impl Counter {
    fun increment(self): void {
        self.value = self.value + 1;
    }

    fun double_increment(self): void {
        self.increment();
    }
}

fun main(): i32 {
    let c = Counter { value: 0 };
    c.double_increment();
    printf("Value: %d\n", c.value);
    return 0;
}