extern fun printf(fmt: string, ...): void;
extern fun scanf(fmt: string, ...): void;

fun main(): i32 {
    let a = 0;
    let b = 0;
    let op = '+';

    printf("Enter a: ");
    scanf("%d", &a);

    printf("Enter b: ");
    scanf("%d", &b);

    printf("Enter operator: ");
    scanf(" %c", &op);

    let result = 0;
    if op == '+' {
        result = a + b;
    } else if op == '-' {
        result = a - b;
    } else if op == '*' {
        result = a * b;
    } else {
        printf("Invalid operator: %c\n", op);
        return 0;
    }

    printf("Result: %d\n", result);

    return 0;
}