extern fun printf(format: string, ...): i32;

fun main() {

    if 2 == 2 {
        printf("Hello, World!\n");
    }

    if 1 == 2 {
        printf("True!\n");
    } else if 1 == 3 {
        printf("1 == 1\n");
    } else {
        printf("False!\n");
    }

    let count = 0;
    while count < 5 {
        printf("Count: %d\n", count);

        count += 1;
    }
}